# ═══════════════════════════════════════════════════════════
# CrownWrite Environment Variables — Example Template
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# SUPABASE CONFIGURATION (Database & Authentication)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx...

# ─────────────────────────────────────────────────────────────
# POLAR PAYMENT INTEGRATION (Subscriptions & Payments)
# Get this from: https://polar.sh/dashboard/settings/api
# ─────────────────────────────────────────────────────────────
POLAR_API_TOKEN=polar_sk_xxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# AI HUMANIZATION PROMPT
# Path to the prompt file (default location)
# ─────────────────────────────────────────────────────────────
HUMANIZATION_PROMPT_PATH=./prompts/humanization-system.txt

# ─────────────────────────────────────────────────────────────
# GOOGLE GEMINI API KEY (Primary AI Provider)
# Get free key at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# GOOGLE CLOUD VERTEX AI (Fine-Tuned Model - Optional)
# Your fine-tuned CrownWrite humanizer model
# ─────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
TUNED_MODEL_ENDPOINT=your-endpoint-id

# ─────────────────────────────────────────────────────────────
# OPENAI API KEY (REQUIRED for humanization to work)
# Get your key from: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ─────────────────────────────────────────────────────────────
# OPTIONAL: Alternative AI Provider
# Uncomment if using Anthropic instead of or in addition to OpenAI
# ─────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# OPTIONAL: Rate Limiting & Security
# Uncomment to customize rate limiting behavior
# ─────────────────────────────────────────────────────────────
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=900000
# JWT_SECRET=your_random_secret_string_here

# ─────────────────────────────────────────────────────────────
# OPTIONAL: Email Service (for notifications and support)
# Uncomment if using Resend for transactional emails
# ─────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# SUPPORT_EMAIL=hello@crownwrite.com
